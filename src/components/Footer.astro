---
import { SITE, LINKS } from "../consts";

const year = new Date().getFullYear();
---

{/*
  No top margin: every page's final section already carries `pb-section`, and
  adding `mt-section` on top of it stacked into a large dead band above the rule.
  The footer's own `py` provides the breathing room.
*/}
<footer class="rule-t relative z-10">
  <div
    class="shell grid grid-cols-1 gap-8 py-10 md:grid-cols-12 md:gap-gutter md:py-14"
  >
    <div class="md:col-span-5">
      <p class="spec text-ink-muted">Contact</p>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-2 block text-lg tracking-tight transition-colors duration-150 ease-standard hover:text-accent"
      >
        {SITE.email}
      </a>
      <p class="mt-1 text-sm text-ink-muted">
        {SITE.role} · {SITE.company} · {SITE.location}
      </p>
    </div>

    <div class="md:col-span-4 md:col-start-7">
      <p class="spec text-ink-muted">Elsewhere</p>
      <ul class="mt-2 flex flex-col gap-1">
        {
          LINKS.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="text-sm transition-colors duration-150 ease-standard hover:text-accent"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-2 md:col-start-11 md:text-right">
      <p class="spec text-ink-muted">© {year}</p>
      <p class="spec mt-2 text-ink-muted">Built with Astro</p>
    </div>
  </div>
</footer>
