---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkIndex from "../components/WorkIndex.astro";
import { SITE, PRIMARY_LINKS, LINKS, OTHER_WORK } from "../consts";
import portrait from "../assets/portrait.jpg";
import otherWorkCover from "../assets/work/other-work.jpg";

const entries = (await getCollection("work", ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);

const social = LINKS.filter((l) => l.label === "LinkedIn" || l.label === "Instagram");
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <!-- Masthead — mirrors the current portfolio: portrait left, identity and intro right -->
  <section class="shell pt-12 pb-section md:pt-20">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-gutter">
      <div class="md:col-span-1">
        <p class="spec text-accent">01</p>
      </div>

      <div class="md:col-span-4">
        <Image
          src={portrait}
          alt="Mark Pachucki"
          widths={[400, 640, 900]}
          sizes="(min-width: 768px) 32vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="w-full border border-rule"
        />
      </div>

      <div class="md:col-span-6 md:col-start-7">
        <h1 class="text-display-sm font-medium tracking-tight">{SITE.name}</h1>
        <p class="spec mt-2 text-accent">{SITE.role}</p>

        <div class="mt-8 flex max-w-prose flex-col gap-4 text-lg text-ink-muted">
          {SITE.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="rule-t mt-8 flex flex-wrap gap-x-6 gap-y-2 pt-4">
          {
            PRIMARY_LINKS.map(({ label, href }) => (
              <a
                href={href}
                class="spec text-ink transition-colors duration-150 ease-standard hover:text-accent"
              >
                {label}
              </a>
            ))
          }
        </div>

        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          {
            social.map(({ label, href }) => (
              <a
                href={href}
                rel="me noopener"
                class="spec text-ink-muted transition-colors duration-150 ease-standard hover:text-accent"
              >
                {label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="shell pb-section">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-gutter">
      <div class="md:col-span-1">
        <p class="spec text-accent">02</p>
      </div>
      <div class="md:col-span-11">
        <div class="rule-b flex items-baseline justify-between pb-3">
          <h2 class="spec text-ink">Selected work</h2>
          <p class="spec tabular-nums text-ink-muted">
            {String(entries.length).padStart(2, "0")} projects
          </p>
        </div>

        {
          entries.length > 0 ? (
            <div class="mt-2">
              <WorkIndex entries={entries} />
            </div>
          ) : (
            <p class="mt-6 text-sm text-ink-muted">
              No published case studies yet.
            </p>
          )
        }

        {/*
          Deliberately laid out on the same 12-column grid as WorkIndex, with the
          thumbnail in the same 3-column slot, so it reads as the last row of the
          index rather than a footnote under it.
        */}
        <a
          href="/other-work/"
          class="rule-b group grid grid-cols-1 gap-x-gutter gap-y-4 py-6 transition-colors duration-200 ease-standard md:grid-cols-12 md:py-7"
        >
          <span class="spec self-start pt-1 text-ink-muted transition-colors duration-200 ease-standard group-hover:text-accent md:col-span-1">
            +
          </span>

          <div class="overflow-hidden border border-rule bg-surface md:col-span-3">
            <Image
              src={otherWorkCover}
              alt="A research room with sticky-note boards leaning against the walls, a whiteboard headed Q2 2020 Lexio Research, and printed screens pinned across the far wall."
              widths={[320, 480, 640]}
              sizes="(min-width: 768px) 24vw, 100vw"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full object-cover object-center transition-[scale] duration-300 ease-standard group-hover:scale-[1.02]"
            />
          </div>

          <div class="md:col-span-8">
            <h3 class="text-display-sm font-medium tracking-tight transition-colors duration-200 ease-standard group-hover:text-accent">
              {OTHER_WORK.title}
            </h3>
            <p class="mt-2 max-w-prose text-sm text-ink-muted">
              {OTHER_WORK.summary}
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
