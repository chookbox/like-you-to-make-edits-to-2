---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, LINKS } from "../consts";

/**
 * Mirrors the UXfolio "About me" page: the personal story, not the résumé.
 *
 * The professional history deliberately isn't here — it lives in the résumé PDF,
 * exactly as it did on UXfolio. `EXPERIENCE`, `EDUCATION` and `CAPABILITIES` are
 * still exported from consts.ts and can be dropped in as a section below if a
 * timeline on the page is ever wanted.
 */

const facts = [
  "I received a scholarship to Virginia Tech in Photography and was the first student to study both Business & Design.",
  "I love to travel. So much so that I left my job in 2017 to backpack around the world for a year. Some highlights include: volunteering at an elephant sanctuary in Thailand, hiking to Mt. Everest Base Camp, and doing a Vipassanā course in Nepal where I meditated in silence for 10 days.",
  "What I love most about Design is the power it has to help people by saving them time & effort (the most valuable resources in the world).",
  "Outside of work, I enjoy exploring Berlin, playing soccer, going to concerts, photography, snowboarding, & learning new things.",
];
---

<BaseLayout
  title="About"
  description="Mark Pachucki — a bit about myself: rural Virginia, a 2-megapixel camera, a serendipitous path into design, and a year spent backpacking."
>
  <section class="shell pt-16 pb-section md:pt-24">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-gutter">
      <div class="md:col-span-1">
        <p class="spec text-accent">01</p>
      </div>

      <div class="md:col-span-7">
        <h1 class="text-display-sm font-medium tracking-tight">
          A bit about myself
        </h1>

        <div class="prose mt-8">
          <p>
            Growing up in rural Virginia, I didn't have much stimulus so I had to
            make my own fun. From an early age, I was fascinated with computers,
            electronic gadgets, and the possibilities they unlocked. You could
            often find me out in the woods, shooting videos on my 2-megapixel
            digital camera, then editing the footage on our Windows 98 computer
            while learning the ins &amp; outs of various creative software.
          </p>
          <p>
            That upbringing really jumpstarted my curiosity with the outside
            world and the potential of using computers to bring it to life &amp;
            share with others in a variety of ways. Through a serendipitous path
            of elective courses in college, I discovered the field of Design
            &amp; knew that it was my calling. Since then, I've pursued Design in
            all its different forms without looking back.
          </p>
        </div>
      </div>

      <div class="md:col-span-3 md:col-start-10">
        <p class="spec rule-b pb-2 text-ink-muted">Elsewhere</p>
        <ul class="mt-3 flex flex-col gap-1.5">
          {
            LINKS.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="text-sm transition-colors duration-150 ease-standard hover:text-accent"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>

        <p class="spec rule-b mt-8 pb-2 text-ink-muted">Currently</p>
        <p class="mt-3 text-sm text-ink-muted">
          {SITE.role} at {SITE.company}, based in {SITE.location}.
        </p>
      </div>
    </div>
  </section>

  <!-- A few other facts -->
  <section class="shell pb-section">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-gutter">
      <div class="md:col-span-1">
        <p class="spec text-accent">02</p>
      </div>

      <div class="md:col-span-11">
        <h2 class="spec rule-b pb-3 text-ink">A few other facts about me</h2>

        <ol class="rule-t mt-2">
          {
            facts.map((fact, i) => (
              <li class="rule-b grid grid-cols-1 gap-3 py-6 md:grid-cols-12 md:gap-gutter">
                <span class="spec text-ink-muted md:col-span-1">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <p class="max-w-prose text-base text-ink md:col-span-8">
                  {fact}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
